# Copy to .env for local runs. On Render, add these under the service's Environment tab instead.

# Required for the TikTok competitors tab. Euka app → Settings → Integrations → OpenAPI keys.
EUKA_API_KEY=

# Required. Use a long random value (20+ characters). The token to sign in to the dashboard (nothing is served without it). Also used by scripts as x-admin-token.
ADMIN_TOKEN=
# Hours a sign-in lasts on one browser before asking for the token again.
SESSION_HOURS=6

# Customer catalog at /catalog. Its own password, separate from ADMIN_TOKEN, so customers never get dashboard access.
CATALOG_PASSWORD=
# Catalog 2 at /catalog2 (no prices by default); Catalog N uses CATALOGN_PASSWORD (CATALOG3_PASSWORD, …).
# Any catalog password can also be set on the dashboard's Catalog management page.
CATALOG2_PASSWORD=
# Hours a catalog sign-in lasts (defaults to SESSION_HOURS).
CATALOG_SESSION_HOURS=6
# Products added within this many days get the NEW tag.
CATALOG_NEW_DAYS=30

# Optional. Our own TikTok shop names (comma separated), left out of competitors.
# Our own listings are already excluded by the tiktok_product_id in the products API.
OUR_TIKTOK_SHOP_NAMES=

# Tuning (defaults shown)
COMPETITORS_PER_SKU=5
# Euka's quota is weekly, so by default each SKU is searched once a week.
COMPETITOR_REFRESH_HOURS=168
# A SKU is never searched again within this many hours, even from "Refresh all now".
COMPETITOR_MIN_GAP_HOURS=2
COMPETITOR_MIN_SCORE=0.6
EUKA_REGION=US
EUKA_CONCURRENCY=2
# Minimum gap between any two Euka calls (Euka rate-limits the key).
EUKA_MIN_INTERVAL_MS=1500
EUKA_DELAY_MS=250
EUKA_API_BASE=https://server.euka.ai/api/v1
EUKA_PRODUCT_SEARCH_PATH=/social-intelligence/products
# Which Euka indexes to search: social (product search), market (Market Intelligence), or both.
# Market Intelligence also finds listings with no sales this month and adds commission, growth,
# SKU price range, creators and reviews. It turns itself off for a run if the key can't use it.
EUKA_SOURCES=social,market
# 1 = call Market Intelligence product/detail for each kept match (one extra call per match).
EUKA_MI_DETAIL=1
# Optional: limit Market Intelligence search to these TikTok category ids (comma separated).
EUKA_MI_CATEGORY_IDS=

# Data directory for everything the server saves: catalog settings and passwords, competitor results and pins,
# and the activity log. Point it at a Render persistent disk (e.g. /var/data) or it's wiped on every deploy.
COMPETITOR_DATA_DIR=./data

# Activity log (activity.log in the data directory): days kept, and a size cap in MB (oldest entries go first).
ACTIVITY_LOG_DAYS=90
ACTIVITY_LOG_MAX_MB=20

# Products API (default shown)
PRODUCTS_API=https://hub.fragrancewholesalerusa.com/api/open/products

# Optional: which Euka brand to read as (defaults to the first brand on the key with TikTok Shop connected).
EUKA_BRAND_ID=

# Catalog pictures fall back to the hub storefront's product list (default shown).
HUB_IMAGES_API=https://hub.fragrancewholesalerusa.com/api/ecom/search
# Optional: save catalog settings somewhere other than COMPETITOR_DATA_DIR.
CATALOG_DATA_DIR=

# Excel write-back (edits from a product's "Excel sheet" section go into the workbook in OneDrive).
# From an Entra app registration with the Microsoft Graph application permission Files.ReadWrite.All
# (admin consent granted).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Which workbook: a link to it, or the owner's sign-in plus the path in their OneDrive (defaults shown).
EXCEL_FILE_URL=
EXCEL_USER=office@americanseairimports.onmicrosoft.com
EXCEL_PATH=TIKTOK PRICING 786110.xlsx
EXCEL_SHEET=0. MASTER
EXCEL_SKU_HEADER=SKU #
# Optional: columns (letters or header names, comma separated) that should stay read only.
EXCEL_LOCKED_COLUMNS=
# Optional: header row number (0 = find the row holding EXCEL_SKU_HEADER).
EXCEL_HEADER_ROW=0
