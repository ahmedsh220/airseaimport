# Copy to .env for local runs. On Render, add these under the service's Environment tab instead.

# Required for the TikTok competitors tab. Euka app → Settings → Integrations → OpenAPI keys.
EUKA_API_KEY=

# Optional. When set, starting a refresh or pinning/hiding a listing from the page asks for this token.
ADMIN_TOKEN=

# Optional. Our own TikTok shop names (comma separated), left out of competitors.
# Our own listings are already excluded by the tiktok_product_id in the products API.
OUR_TIKTOK_SHOP_NAMES=

# Tuning (defaults shown)
COMPETITORS_PER_SKU=5
COMPETITOR_REFRESH_HOURS=12
# A SKU is never searched again within this many hours, even from "Refresh all now".
COMPETITOR_MIN_GAP_HOURS=2
COMPETITOR_MIN_SCORE=0.6
EUKA_REGION=US
EUKA_CONCURRENCY=3
EUKA_DELAY_MS=250
EUKA_API_BASE=https://server.euka.ai/api/v1
EUKA_PRODUCT_SEARCH_PATH=/social-intelligence/products
# Which Euka indexes to search: social (product search), market (Market Intelligence), or both.
# Market Intelligence also finds listings with no sales this month and adds commission, growth,
# SKU price range, creators and reviews. It turns itself off for a run if the key can't use it.
EUKA_SOURCES=social,market
# 1 = call Market Intelligence product/detail for each kept match (one extra call per match).
EUKA_MI_DETAIL=1
# Optional: limit Market Intelligence search to these TikTok category ids (comma separated).
EUKA_MI_CATEGORY_IDS=

# Where results and pins are saved. Point it at a Render persistent disk to keep them across deploys.
# Point this at a Render persistent disk (e.g. /var/data) so results survive restarts and deploys.
COMPETITOR_DATA_DIR=./data

# Products API (default shown)
PRODUCTS_API=https://hub.fragrancewholesalerusa.com/api/open/products
